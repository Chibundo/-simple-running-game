# Supply your own DNS, certificate and TLS configuration before use.
# Run the built game with PORT=3001 ALLOWED_ORIGINS=https://game.example npm start.
# This example is included in nginx's http {} context.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
server {
    listen 443 ssl;
    server_name game.example;
    ssl_certificate     /etc/ssl/game/fullchain.pem;
    ssl_certificate_key /etc/ssl/game/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
    }
}
