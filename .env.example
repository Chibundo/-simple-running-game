# Optional Vite build-time override. Leave unset for the same-origin /ws endpoint.
# VITE_SERVER_URL=wss://your-race-server.example/ws
# Server runtime options (defaults shown). The shell or host must export these;
# the production server does not automatically read .env files.
# PORT=3001
# HOST=0.0.0.0
# ALLOWED_ORIGINS=https://your-game.example
# RACE_DURATION_MS=45000
# RACE_COUNTDOWN_MS=3000
# RACE_RECONNECT_GRACE_MS=15000
